{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alpha:capability-approval:v0.1",
  "title": "Capability Approval Records v0.1",
  "oneOf": [
    { "$ref": "#/$defs/approvalRequest" },
    { "$ref": "#/$defs/approvalDecision" }
  ],
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "logicalRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "approvalMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalRequestId",
        "operationId",
        "callId",
        "workspaceId",
        "appId",
        "releaseId",
        "releaseResolutionDigest",
        "capabilityRef"
      ],
      "properties": {
        "approvalRequestId": { "$ref": "#/$defs/opaqueId" },
        "operationId": { "$ref": "#/$defs/opaqueId" },
        "callId": { "$ref": "#/$defs/opaqueId" },
        "workspaceId": { "$ref": "#/$defs/opaqueId" },
        "appId": { "$ref": "#/$defs/opaqueId" },
        "releaseId": { "$ref": "#/$defs/opaqueId" },
        "releaseResolutionDigest": { "$ref": "#/$defs/digest" },
        "capabilityRef": { "$ref": "#/$defs/logicalRef" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "classification"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "value": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "classification": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "actionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "facts", "estimatedMaximumCostMicrousd"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "facts": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/fact" }
        },
        "estimatedMaximumCostMicrousd": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        }
      }
    },
    "approvalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": { "const": "alpha.platform.capability/v0.1" },
        "kind": { "const": "CapabilityApprovalRequest" },
        "metadata": { "$ref": "#/$defs/approvalMetadata" },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorizationDigest",
            "effectDigest",
            "effectClass",
            "riskClass",
            "approvalMode",
            "requestedScope",
            "actionSummary",
            "evidenceRefs",
            "requestedAt",
            "expiresAt"
          ],
          "properties": {
            "authorizationDigest": { "$ref": "#/$defs/digest" },
            "effectDigest": { "$ref": "#/$defs/digest" },
            "effectClass": { "type": "string", "minLength": 1 },
            "riskClass": { "enum": ["none", "low", "moderate", "high", "critical"] },
            "approvalMode": { "enum": ["first-use", "always"] },
            "requestedScope": { "enum": ["operation", "binding"] },
            "actionSummary": { "$ref": "#/$defs/actionSummary" },
            "evidenceRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/opaqueId" }
            },
            "requestedAt": { "type": "string", "format": "date-time" },
            "expiresAt": { "type": "string", "format": "date-time" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "approvalMode": { "const": "always" } },
                "required": ["approvalMode"]
              },
              "then": {
                "properties": { "requestedScope": { "const": "operation" } }
              }
            }
          ]
        }
      }
    },
    "approvalDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": { "const": "alpha.platform.capability/v0.1" },
        "kind": { "const": "CapabilityApprovalDecision" },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decisionId", "approvalRequestId"],
          "properties": {
            "decisionId": { "$ref": "#/$defs/opaqueId" },
            "approvalRequestId": { "$ref": "#/$defs/opaqueId" }
          }
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "principalId",
            "principalType",
            "scope",
            "authorizationDigest",
            "effectDigest",
            "reason",
            "decidedAt",
            "expiresAt"
          ],
          "properties": {
            "outcome": { "enum": ["approved", "denied", "expired", "cancelled"] },
            "principalId": { "$ref": "#/$defs/opaqueId" },
            "principalType": { "enum": ["user", "policy"] },
            "scope": { "enum": ["operation", "binding"] },
            "authorizationDigest": { "$ref": "#/$defs/digest" },
            "effectDigest": { "$ref": "#/$defs/digest" },
            "reason": {
              "oneOf": [
                { "type": "string", "minLength": 1, "maxLength": 2000 },
                { "type": "null" }
              ]
            },
            "decidedAt": { "type": "string", "format": "date-time" },
            "expiresAt": {
              "oneOf": [
                { "type": "string", "format": "date-time" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    }
  }
}
