{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alpha:app-ui-bridge:v0.1",
  "title": "App UI Bridge v0.1",
  "description": "Session Grant, request, response, and filtered event envelopes for platform-native and isolated custom App surfaces.",
  "oneOf": [
    { "$ref": "#/$defs/sessionGrant" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "logicalRef": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "methodName": {
      "enum": [
        "resource.read",
        "entrypoint.invoke",
        "operation.get",
        "artifact.request-upload",
        "artifact.open",
        "shell.open"
      ]
    },
    "methodGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "requestSchemaDigest", "responseSchemaDigest"],
      "properties": {
        "method": { "$ref": "#/$defs/methodName" },
        "requestSchemaDigest": { "$ref": "#/$defs/digest" },
        "responseSchemaDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "entrypointGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypointRef", "kind", "inputSchemaDigest", "outputSchemaDigest", "idempotencyMode"],
      "properties": {
        "entrypointRef": { "$ref": "#/$defs/logicalRef" },
        "kind": { "enum": ["query", "action", "job"] },
        "inputSchemaDigest": { "$ref": "#/$defs/digest" },
        "outputSchemaDigest": { "$ref": "#/$defs/digest" },
        "idempotencyMode": { "enum": ["none", "caller-key", "occurrence-key"] }
      }
    },
    "resourceGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewRef", "resourceRef", "kind", "operations", "fieldProjection", "pathPrefixes", "classificationCeiling", "visibilityPolicyDigest", "operationSchemaDigest"],
      "properties": {
        "viewRef": { "$ref": "#/$defs/logicalRef" },
        "resourceRef": { "$ref": "#/$defs/logicalRef" },
        "kind": { "enum": ["table", "file-store"] },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["describe", "get", "query", "count", "aggregate", "stat", "list"] }
        },
        "fieldProjection": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "pathPrefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/[^.][^\\u0000]*$" }
        },
        "classificationCeiling": { "enum": ["public", "internal", "confidential", "restricted"] },
        "visibilityPolicyDigest": { "$ref": "#/$defs/digest" },
        "operationSchemaDigest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "table" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "fieldProjection": { "minItems": 1 },
              "pathPrefixes": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "file-store" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "fieldProjection": { "maxItems": 0 },
              "pathPrefixes": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "sessionGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": { "const": "alpha.platform.app-ui/v0.1" },
        "kind": { "const": "AppUiSessionGrant" },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessionId", "issuedAt", "expiresAt", "nonce", "revocationRef"],
          "properties": {
            "sessionId": { "$ref": "#/$defs/opaqueId" },
            "issuedAt": { "type": "string", "format": "date-time" },
            "expiresAt": { "type": "string", "format": "date-time" },
            "nonce": { "$ref": "#/$defs/opaqueId" },
            "revocationRef": { "$ref": "#/$defs/opaqueId" }
          }
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bridgeVersion",
            "userId",
            "workspaceId",
            "appId",
            "appVersionId",
            "releaseId",
            "environment",
            "surfaceId",
            "surfaceArtifactDigest",
            "channelBinding",
            "appRole",
            "methods",
            "entrypoints",
            "resources",
            "shellActions",
            "eventTopics"
          ],
          "properties": {
            "bridgeVersion": { "$ref": "#/$defs/semver" },
            "userId": { "$ref": "#/$defs/opaqueId" },
            "workspaceId": { "$ref": "#/$defs/opaqueId" },
            "appId": { "$ref": "#/$defs/opaqueId" },
            "appVersionId": { "$ref": "#/$defs/opaqueId" },
            "releaseId": { "$ref": "#/$defs/opaqueId" },
            "environment": { "enum": ["preview", "production"] },
            "surfaceId": { "$ref": "#/$defs/logicalRef" },
            "surfaceArtifactDigest": { "$ref": "#/$defs/digest" },
            "channelBinding": { "$ref": "#/$defs/digest" },
            "appRole": { "enum": ["owner", "editor", "operator", "viewer"] },
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/methodGrant" }
            },
            "entrypoints": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/entrypointGrant" }
            },
            "resources": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/resourceGrant" }
            },
            "shellActions": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["activity", "access", "configure", "versions", "run", "record", "artifact", "approval", "connection", "builder"] }
            },
            "eventTopics": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["operation", "run", "approval", "artifact", "app-health", "device"] }
            }
          }
        }
      }
    },
    "requestBase": {
      "type": "object",
      "required": ["apiVersion", "kind", "requestId", "sessionId", "method", "input"],
      "properties": {
        "apiVersion": { "const": "alpha.platform.app-ui/v0.1" },
        "kind": { "const": "AppUiRequest" },
        "requestId": { "$ref": "#/$defs/opaqueId" },
        "sessionId": { "$ref": "#/$defs/opaqueId" },
        "method": { "$ref": "#/$defs/methodName" },
        "input": { "type": "object" }
      }
    },
    "resourceReadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "requestId", "sessionId", "method", "input"],
      "properties": {
        "apiVersion": { "const": "alpha.platform.app-ui/v0.1" },
        "kind": { "const": "AppUiRequest" },
        "requestId": { "$ref": "#/$defs/opaqueId" },
        "sessionId": { "$ref": "#/$defs/opaqueId" },
        "method": { "const": "resource.read" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["viewRef", "resourceRef", "operation", "arguments"],
          "properties": {
            "viewRef": { "$ref": "#/$defs/logicalRef" },
            "resourceRef": { "$ref": "#/$defs/logicalRef" },
            "operation": { "enum": ["describe", "get", "query", "count", "aggregate", "stat", "list"] },
            "arguments": { "type": "object" }
          }
        }
      }
    },
    "entrypointInvokeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "requestId", "sessionId", "method", "input"],
      "properties": {
        "apiVersion": { "const": "alpha.platform.app-ui/v0.1" },
        "kind": { "const": "AppUiRequest" },
        "requestId": { "$ref": "#/$defs/opaqueId" },
        "sessionId": { "$ref": "#/$defs/opaqueId" },
        "method": { "const": "entrypoint.invoke" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entrypointRef", "payload", "idempotencyKey"],
          "properties": {
            "entrypointRef": { "$ref": "#/$defs/logicalRef" },
            "payload": { "$ref": "#/$defs/jsonValue" },
            "idempotencyKey": {
              "oneOf": [
                { "type": "string", "minLength": 1, "maxLength": 256 },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "operationGetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "requestId", "sessionId", "method", "input"],
      "properties": {
        "apiVersion": { "const": "alpha.platform.app-ui/v0.1" },
        "kind": { "const": "AppUiRequest" },
        "requestId": { "$ref": "#/$defs/opaqueId" },
        "sessionId": { "$ref": "#/$defs/opaqueId" },
        "method": { "const": "operation.get" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId"],
          "properties": {
            "operationId": { "$ref": "#/$defs/opaqueId" }
          }
        }
      }
    },
    "artifactUploadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "requestId", "sessionId", "method", "input"],
      "properties": {
        "apiVersion": { "const": "alpha.platform.app-ui/v0.1" },
        "kind": { "const": "AppUiRequest" },
        "requestId": { "$ref": "#/$defs/opaqueId" },
        "sessionId": { "$ref": "#/$defs/opaqueId" },
        "method": { "const": "artifact.request-upload" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["purpose", "acceptedMediaTypes", "maxBytes", "multiple"],
          "properties": {
            "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
            "acceptedMediaTypes": { "$ref": "#/$defs/stringSet" },
            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
            "multiple": { "type": "boolean" }
          }
        }
      }
    },
    "artifactOpenRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "requestId", "sessionId", "method", "input"],
      "properties": {
        "apiVersion": { "const": "alpha.platform.app-ui/v0.1" },
        "kind": { "const": "AppUiRequest" },
        "requestId": { "$ref": "#/$defs/opaqueId" },
        "sessionId": { "$ref": "#/$defs/opaqueId" },
        "method": { "const": "artifact.open" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactId", "mode"],
          "properties": {
            "artifactId": { "$ref": "#/$defs/opaqueId" },
            "mode": { "enum": ["view", "download"] }
          }
        }
      }
    },
    "shellOpenRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "requestId", "sessionId", "method", "input"],
      "properties": {
        "apiVersion": { "const": "alpha.platform.app-ui/v0.1" },
        "kind": { "const": "AppUiRequest" },
        "requestId": { "$ref": "#/$defs/opaqueId" },
        "sessionId": { "$ref": "#/$defs/opaqueId" },
        "method": { "const": "shell.open" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["view", "referenceId", "initialMessage"],
          "properties": {
            "view": { "enum": ["activity", "access", "configure", "versions", "run", "record", "artifact", "approval", "connection", "builder"] },
            "referenceId": {
              "oneOf": [
                { "$ref": "#/$defs/opaqueId" },
                { "type": "null" }
              ]
            },
            "initialMessage": {
              "oneOf": [
                { "type": "string", "minLength": 1, "maxLength": 2000 },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "request": {
      "oneOf": [
        { "$ref": "#/$defs/resourceReadRequest" },
        { "$ref": "#/$defs/entrypointInvokeRequest" },
        { "$ref": "#/$defs/operationGetRequest" },
        { "$ref": "#/$defs/artifactUploadRequest" },
        { "$ref": "#/$defs/artifactOpenRequest" },
        { "$ref": "#/$defs/shellOpenRequest" }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "state", "acceptedAt", "runId", "approvalId", "deviceOperationId"],
      "properties": {
        "operationId": { "$ref": "#/$defs/opaqueId" },
        "state": { "enum": ["accepted", "running", "waiting-for-approval", "waiting-for-connection", "waiting-for-device", "waiting-for-input", "succeeded", "failed", "cancelled"] },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "runId": {
          "oneOf": [
            { "$ref": "#/$defs/opaqueId" },
            { "type": "null" }
          ]
        },
        "approvalId": {
          "oneOf": [
            { "$ref": "#/$defs/opaqueId" },
            { "type": "null" }
          ]
        },
        "deviceOperationId": {
          "oneOf": [
            { "$ref": "#/$defs/opaqueId" },
            { "type": "null" }
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "shellAction"],
      "properties": {
        "code": {
          "enum": [
            "authorization_denied",
            "session_expired",
            "release_changed",
            "method_not_granted",
            "schema_invalid",
            "resource_not_visible",
            "entrypoint_not_visible",
            "revision_conflict",
            "approval_required",
            "connection_required",
            "waiting_for_device",
            "budget_exhausted",
            "rate_limited",
            "temporarily_unavailable",
            "operation_failed"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "retryable": { "type": "boolean" },
        "shellAction": {
          "oneOf": [
            { "enum": ["activity", "access", "configure", "versions", "run", "record", "artifact", "approval", "connection", "builder"] },
            { "type": "null" }
          ]
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "requestId", "sessionId", "status", "resultSchemaDigest", "result", "receipt", "error", "completedAt"],
      "properties": {
        "apiVersion": { "const": "alpha.platform.app-ui/v0.1" },
        "kind": { "const": "AppUiResponse" },
        "requestId": { "$ref": "#/$defs/opaqueId" },
        "sessionId": { "$ref": "#/$defs/opaqueId" },
        "status": { "enum": ["succeeded", "accepted", "blocked", "failed"] },
        "resultSchemaDigest": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "result": { "$ref": "#/$defs/jsonValue" },
        "receipt": {
          "oneOf": [
            { "$ref": "#/$defs/receipt" },
            { "type": "null" }
          ]
        },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/error" },
            { "type": "null" }
          ]
        },
        "completedAt": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
          "then": {
            "properties": {
              "error": { "type": "null" },
              "completedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["accepted", "blocked"] } }, "required": ["status"] },
          "then": {
            "properties": {
              "receipt": { "$ref": "#/$defs/receipt" },
              "error": { "type": "null" },
              "completedAt": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "error": { "$ref": "#/$defs/error" },
              "completedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "sessionId", "eventId", "cursor", "sequence", "topic", "type", "subject", "payloadSchemaDigest", "payload", "occurredAt"],
      "properties": {
        "apiVersion": { "const": "alpha.platform.app-ui/v0.1" },
        "kind": { "const": "AppUiEvent" },
        "sessionId": { "$ref": "#/$defs/opaqueId" },
        "eventId": { "$ref": "#/$defs/opaqueId" },
        "cursor": { "$ref": "#/$defs/opaqueId" },
        "sequence": { "type": "integer", "minimum": 1 },
        "topic": { "enum": ["operation", "run", "approval", "artifact", "app-health", "device"] },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["operation", "run", "approval", "artifact", "app", "device-operation"] },
            "id": { "$ref": "#/$defs/opaqueId" }
          }
        },
        "payloadSchemaDigest": { "$ref": "#/$defs/digest" },
        "payload": { "$ref": "#/$defs/jsonValue" },
        "occurredAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
