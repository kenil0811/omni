{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alpha:app-contract:v0.1",
  "title": "Alpha Source App Manifest v0.1 revision 5",
  "description": "Accepted v0 design baseline for the reduced builder-authored app.yaml, including authenticated platform-managed webhook triggers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "alpha.platform/v0.1" },
    "kind": { "const": "AppManifest" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "capabilityName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "displayName", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "labels": { "$ref": "#/$defs/stringMap" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "components", "entrypoints", "tests"],
      "properties": {
        "compatibility": { "$ref": "#/$defs/compatibility" },
        "configuration": { "$ref": "#/$defs/configuration" },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component" }
        },
        "surfaces": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/surface" }
        },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entrypoint" }
        },
        "triggers": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/trigger" }
        },
        "resources": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/resource" }
        },
        "connections": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/connection" }
        },
        "capabilities": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/capabilityRequirement" }
        },
        "context": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/contextAccess" }
        },
        "policies": {
          "$ref": "#/$defs/policies",
          "default": { "approvalRequests": [] }
        },
        "observability": {
          "$ref": "#/$defs/observability",
          "default": {
            "evidence": {
              "capture": [],
              "redactPaths": []
            }
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/test" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["kind", "requiredFor"],
                "properties": {
                  "kind": { "enum": ["fixture", "outcome"] },
                  "requiredFor": {
                    "type": "array",
                    "contains": { "const": "preview" }
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["kind", "requiredFor"],
                "properties": {
                  "kind": { "enum": ["fixture", "outcome", "health"] },
                  "requiredFor": {
                    "type": "array",
                    "contains": { "const": "release" }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk"],
      "properties": {
        "sdk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": { "$ref": "#/$defs/packagePath" },
        "uiSchema": { "$ref": "#/$defs/packagePath" },
        "defaults": { "$ref": "#/$defs/packagePath" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": ["handler-bundle", "agent", "native-view", "micro-frontend"]
        },
        "source": { "$ref": "#/$defs/packagePath" },
        "dependencyLock": { "$ref": "#/$defs/packagePath" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "enum": ["handler-bundle", "micro-frontend"] }
            },
            "required": ["kind"]
          },
          "then": { "required": ["dependencyLock"] }
        }
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "componentRef", "title", "route"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["native-page", "micro-frontend"] },
        "componentRef": { "$ref": "#/$defs/identifier" },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "route": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$"
        },
        "entrypointRefs": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "resourceRefs": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "componentRef",
        "handler",
        "inputSchema",
        "outputSchema",
        "invocation",
        "execution",
        "idempotency",
        "outcome"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["action", "query", "job"] },
        "componentRef": { "$ref": "#/$defs/identifier" },
        "handler": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,255}$"
        },
        "inputSchema": { "$ref": "#/$defs/packagePath" },
        "outputSchema": { "$ref": "#/$defs/packagePath" },
        "invocation": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ui", "chat", "manual", "schedule", "webhook"] }
        },
        "capabilities": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "resourceAccess": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/resourceAccess" }
        },
        "context": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "execution": { "$ref": "#/$defs/execution" },
        "idempotency": { "$ref": "#/$defs/idempotency" },
        "outcome": { "$ref": "#/$defs/outcome" }
      }
    },
    "resourceAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceRef", "modes"],
      "properties": {
        "resourceRef": { "$ref": "#/$defs/identifier" },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["read", "append", "write", "delete"] }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutSeconds"],
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "retry": {
          "$ref": "#/$defs/retry",
          "default": { "maxAttempts": 1, "strategy": "none" }
        },
        "concurrency": {
          "$ref": "#/$defs/concurrency",
          "default": { "mode": "singleton" }
        },
        "budgets": {
          "$ref": "#/$defs/budgets",
          "default": {}
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "strategy"],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "strategy": { "enum": ["none", "fixed", "exponential"] },
        "baseDelaySeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["parallel", "singleton"] },
        "maxParallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelCalls": { "type": "integer", "minimum": 0 },
        "browserSeconds": { "type": "integer", "minimum": 0 },
        "capabilityCalls": { "type": "integer", "minimum": 0 },
        "costMicrousd": { "type": "integer", "minimum": 0 }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "caller-key", "occurrence-key"] },
        "keyPointer": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "caller-key" } },
            "required": ["mode"]
          },
          "then": { "required": ["keyPointer"] }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humanReview"],
      "properties": {
        "evaluatorRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "humanReview": {
          "enum": ["never", "on-failure", "on-low-confidence", "always"]
        }
      }
    },
    "scheduleTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "entrypointRef", "settingsSchema"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "schedule" },
        "entrypointRef": { "$ref": "#/$defs/identifier" },
        "settingsSchema": { "$ref": "#/$defs/packagePath" }
      }
    },
    "webhookVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier", "connectionRef"],
      "properties": {
        "verifier": { "$ref": "#/$defs/capabilityName" },
        "connectionRef": { "$ref": "#/$defs/identifier" }
      }
    },
    "webhookNormalization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "identity" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "mappingRef"],
          "properties": {
            "mode": { "const": "declarative" },
            "mappingRef": { "$ref": "#/$defs/packagePath" }
          }
        }
      ]
    },
    "webhookLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxPayloadBytes", "maxEventsPerMinute", "deduplicationWindowSeconds"],
      "properties": {
        "maxPayloadBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "maxEventsPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000
        },
        "deduplicationWindowSeconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 2592000
        }
      }
    },
    "webhookTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "entrypointRef",
        "purpose",
        "payloadSchema",
        "normalization",
        "methods",
        "acceptedMediaTypes",
        "verification",
        "limits"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "webhook" },
        "entrypointRef": { "$ref": "#/$defs/identifier" },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "payloadSchema": { "$ref": "#/$defs/packagePath" },
        "normalization": { "$ref": "#/$defs/webhookNormalization" },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "const": "POST" }
        },
        "acceptedMediaTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "const": "application/json" }
        },
        "verification": { "$ref": "#/$defs/webhookVerification" },
        "limits": { "$ref": "#/$defs/webhookLimits" }
      }
    },
    "trigger": {
      "oneOf": [
        { "$ref": "#/$defs/scheduleTrigger" },
        { "$ref": "#/$defs/webhookTrigger" }
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "schemaVersion", "classificationHint"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["table", "file-store"] },
        "schemaRef": { "$ref": "#/$defs/packagePath" },
        "acceptedMediaTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        },
        "maxFileSizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "classificationHint": {
          "enum": ["public", "internal", "confidential", "restricted"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "table" } },
            "required": ["kind"]
          },
          "then": { "required": ["schemaRef"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "file-store" } },
            "required": ["kind"]
          },
          "then": { "required": ["acceptedMediaTypes"] }
        }
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "connector", "onUnavailable", "scopes", "purpose"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "connector": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
        },
        "onUnavailable": {
          "enum": ["fail", "use-unconnected-mode", "disable-dependent-capabilities", "disable-dependent-entrypoints"]
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "purpose", "constraints"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "capability": { "$ref": "#/$defs/capabilityName" },
        "connectionRef": { "$ref": "#/$defs/identifier" },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "constraints": { "type": "object" }
      }
    },
    "contextAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "selector", "purpose", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "scope": { "enum": ["user", "workspace", "app"] },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "required": { "type": "boolean" },
        "maxAgeSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalRequests"],
      "properties": {
        "approvalRequests": {
          "type": "array",
          "items": { "$ref": "#/$defs/approvalRequest" }
        }
      }
    },
    "approvalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityRef", "mode"],
      "properties": {
        "capabilityRef": { "$ref": "#/$defs/identifier" },
        "mode": { "enum": ["always", "first-use"] }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence"],
      "properties": {
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture"],
      "properties": {
        "capture": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["inputs", "outputs", "capability-results", "screenshots"]
          }
        },
        "redactPaths": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(/([^/~]|~[01])*)*$"
          }
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "requiredFor"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["unit", "fixture", "outcome", "health"] },
        "requiredFor": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["build", "preview", "release"] }
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "fixture": { "$ref": "#/$defs/packagePath" },
        "evaluator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
